---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import type { SiteIconName } from '../components/Icon.astro';
import { siteContact } from '../constants/site';

type ContactMethod = {
	icon: SiteIconName;
	label?: string | null;
	href?: string | null;
};

const methods = (
	[
		{ icon: 'phone', label: siteContact.phone.label, href: siteContact.phone.href },
		{ icon: 'mail', label: siteContact.email.label, href: siteContact.email.href },
		{ icon: 'message', label: siteContact.whatsapp.label, href: siteContact.whatsapp.href },
	] satisfies ContactMethod[]
).filter((method) => Boolean(method.label && method.href));
---

<Layout>
	<section class="bg-white py-16 sm:py-20">
		<div class="mx-auto w-full max-w-3xl px-4 text-center sm:px-6 lg:px-8">
			<p class="mb-3 text-xs font-semibold uppercase tracking-[0.35em] text-red-600">Get In Touch</p>
			<h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Contact Us</h1>
			<p class="mt-4 text-base leading-7 text-slate-600 sm:text-lg">
				Ready to book a lesson or have a question? Reach out using any of the details below.
			</p>

			{methods.length > 0 && (
				<ul class="mx-auto mt-10 flex max-w-xl flex-col gap-4">
					{
						methods.map((method) => (
							<li>
								<a
									href={method.href!}
									class="flex items-center gap-4 rounded-2xl border border-slate-200 bg-slate-50 px-6 py-5 text-left shadow-sm transition hover:-translate-y-0.5 hover:border-red-200 hover:shadow-md"
								>
									<span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-red-50 text-red-600">
										<Icon name={method.icon} class="h-6 w-6" />
									</span>
									<span class="text-base font-semibold text-slate-900 sm:text-lg">{method.label}</span>
								</a>
							</li>
						))
					}
				</ul>
			)}
		</div>
	</section>
</Layout>
