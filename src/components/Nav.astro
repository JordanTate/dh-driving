---
import { siteBrand, siteContact, siteNavigation } from '../constants/site';

const links = siteNavigation;
---

<site-nav class="sticky top-0 z-50 block border-b border-slate-200 bg-white/90 backdrop-blur">
	<header class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
		<a href={siteBrand.logoHref} class="text-lg font-semibold tracking-tight text-slate-900">
			{siteBrand.logoLabel}
		</a>

		<nav aria-label="Primary" class="hidden items-center gap-7 md:flex">
			{
				links.map((link) => (
					<a href={link.href} class="text-sm font-medium text-slate-700 transition hover:text-red-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-400 focus-visible:ring-offset-2 rounded-sm">
						{link.label}
					</a>
				))
			}
			<a
				href={siteContact.phone.href}
				class="inline-flex items-center gap-2 rounded-full border border-transparent px-3 py-1.5 text-sm font-medium text-red-600 transition hover:border-red-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-400 focus-visible:ring-offset-2"
			>
				<svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4">
					<path fill="currentColor" d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1C10.85 21 3 13.15 3 3c0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.24.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2Z"></path>
				</svg>
				<span>{siteContact.phone.label}</span>
			</a>
		</nav>

		<button
			type="button"
			data-menu-toggle
			class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-slate-300 text-slate-800 transition hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-400 focus-visible:ring-offset-2 md:hidden"
			aria-expanded="false"
			aria-controls="mobile-menu"
			aria-label="Toggle navigation menu"
		>
			<svg data-menu-icon-open viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5">
				<path fill="currentColor" d="M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z"></path>
			</svg>
			<svg data-menu-icon-close viewBox="0 0 24 24" aria-hidden="true" class="hidden h-5 w-5">
				<path fill="currentColor" d="M18.3 5.71 12 12l6.3 6.29-1.41 1.42L10.59 13.4 4.29 19.7 2.88 18.3 9.17 12 2.88 5.71 4.29 4.3l6.3 6.29 6.29-6.3z"></path>
			</svg>
		</button>
	</header>

	<div data-menu-overlay class="fixed inset-0 z-40 hidden bg-white/35 md:hidden" aria-hidden="true"></div>

	<nav
		id="mobile-menu"
		aria-label="Mobile"
		data-mobile-menu
		class="absolute right-0 top-0 z-100 h-dvh w-[min(22rem,88vw)] translate-x-full border-l border-slate-200 bg-white p-6 shadow-xl transition-transform duration-300 ease-out md:hidden"
	>
		<div class="mb-8 flex items-center justify-between">
			<span class="text-sm font-semibold uppercase tracking-wide text-slate-500">Menu</span>
			<button
				type="button"
				data-menu-close
				class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-slate-300 text-slate-700 transition hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 focus-visible:ring-offset-2"
				aria-label="Close navigation menu"
			>
				<svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5">
					<path fill="currentColor" d="M18.3 5.71 12 12l6.3 6.29-1.41 1.42L10.59 13.4 4.29 19.7 2.88 18.3 9.17 12 2.88 5.71 4.29 4.3l6.3 6.29 6.29-6.3z"></path>
				</svg>
			</button>
		</div>

		<div class="flex flex-col gap-4">
			{
				links.map((link) => (
					<a href={link.href} data-menu-link class="text-base font-medium text-slate-800 transition hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-400 focus-visible:ring-offset-2 rounded-sm">
						{link.label}
					</a>
				))
			}
		</div>

		<a
			href={siteContact.phone.href}
			data-menu-link
			class="mt-8 inline-flex w-fit items-center gap-2 rounded-full bg-red-500 px-3 py-1.5 text-sm font-medium text-white transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-400 focus-visible:ring-offset-2"
		>
			<svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4">
				<path fill="currentColor" d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1C10.85 21 3 13.15 3 3c0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.24.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2Z"></path>
			</svg>
			<span>{siteContact.phone.label}</span>
		</a>
	</nav>
</site-nav>

<script>
	class SiteNav extends HTMLElement {
		toggleButton: HTMLButtonElement | null = null;
		closeButton: HTMLButtonElement | null = null;
		overlay: HTMLDivElement | null = null;
		menu: HTMLElement | null = null;
		openIcon: SVGElement | null = null;
		closeIcon: SVGElement | null = null;
		linkNodes: NodeListOf<HTMLAnchorElement> = document.querySelectorAll('a');
		boundOutsideClick: (event: MouseEvent) => void = () => {};
		boundEscape: (event: KeyboardEvent) => void = () => {};

		connectedCallback() {
			this.toggleButton = this.querySelector('[data-menu-toggle]');
			this.closeButton = this.querySelector('[data-menu-close]');
			this.overlay = this.querySelector('[data-menu-overlay]');
			this.menu = this.querySelector('[data-mobile-menu]');
			this.openIcon = this.querySelector('[data-menu-icon-open]');
			this.closeIcon = this.querySelector('[data-menu-icon-close]');
			this.linkNodes = this.querySelectorAll('[data-menu-link]');
			this.boundOutsideClick = this.handleOutsideClick.bind(this);
			this.boundEscape = this.handleEscape.bind(this);

			if (!this.toggleButton || !this.menu || !this.overlay || !this.openIcon || !this.closeIcon) {
				return;
			}

			this.toggleButton.addEventListener('click', () => this.toggleMenu());
			this.closeButton?.addEventListener('click', () => this.closeMenu());
			this.overlay.addEventListener('click', () => this.closeMenu());
			this.linkNodes.forEach((link) => {
				link.addEventListener('click', () => this.closeMenu());
			});
		}

		disconnectedCallback() {
			document.removeEventListener('click', this.boundOutsideClick);
			document.removeEventListener('keydown', this.boundEscape);
		}

		isOpen() {
			return this.toggleButton?.getAttribute('aria-expanded') === 'true';
		}

		toggleMenu() {
			if (this.isOpen()) {
				this.closeMenu();
				return;
			}
			this.openMenu();
		}

		openMenu() {
			this.toggleButton?.setAttribute('aria-expanded', 'true');
			this.menu?.classList.remove('translate-x-full');
			this.overlay?.classList.remove('hidden');
			this.openIcon?.classList.add('hidden');
			this.closeIcon?.classList.remove('hidden');
			document.body.classList.add('overflow-hidden');
			document.addEventListener('click', this.boundOutsideClick);
			document.addEventListener('keydown', this.boundEscape);
		}

		closeMenu() {
			this.toggleButton?.setAttribute('aria-expanded', 'false');
			this.menu?.classList.add('translate-x-full');
			this.overlay?.classList.add('hidden');
			this.openIcon?.classList.remove('hidden');
			this.closeIcon?.classList.add('hidden');
			document.body.classList.remove('overflow-hidden');
			document.removeEventListener('click', this.boundOutsideClick);
			document.removeEventListener('keydown', this.boundEscape);
		}

		handleOutsideClick(event: MouseEvent) {
			if (!this.isOpen() || !event.target) {
				return;
			}

			const target = event.target as Node;
			const clickedToggle = this.toggleButton?.contains(target);
			const clickedMenu = this.menu?.contains(target);

			if (!clickedToggle && !clickedMenu) {
				this.closeMenu();
			}
		}

		handleEscape(event: KeyboardEvent) {
			if (event.key === 'Escape') {
				this.closeMenu();
			}
		}
	}

	if (!customElements.get('site-nav')) {
		customElements.define('site-nav', SiteNav);
	}
</script>
