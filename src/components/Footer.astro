---
import Icon from './Icon.astro';
import { footerDefaults, siteBrand } from '../constants/site';

type FooterImage = {
	src: string;
	alt: string;
};

type Props = {
	eyebrow?: string | null;
	title?: string | null;
	subtitle?: string | null;
	text?: string | null;
	callLabel?: string | null;
	callHref?: string | null;
	whatsappLabel?: string | null;
	whatsappHref?: string | null;
	image?: FooterImage | null;
};

const {
	title = footerDefaults.title,
	subtitle = footerDefaults.subtitle,
	text = footerDefaults.text,
	callLabel = footerDefaults.callLabel,
	callHref = footerDefaults.callHref,
	whatsappLabel = footerDefaults.whatsappLabel,
	whatsappHref = footerDefaults.whatsappHref,
	image = footerDefaults.image,
} = Astro.props as Props;

const hasCall = Boolean(callLabel && callHref);
const hasWhatsapp = Boolean(whatsappLabel && whatsappHref);
const year = new Date().getFullYear();
---

<footer class="relative mt-20 md:mt-28">
	<svg
		class="absolute inset-x-0 bottom-full block w-full text-red-500"
		viewBox="0 0 1440 80"
		preserveAspectRatio="none"
		aria-hidden="true"
	>
		<path fill="currentColor" d="M0,40 Q720,74 1440,40 L1440,80 L0,80 Z"></path>
	</svg>

	<div class="relative bg-red-500 text-white">
		<div class="relative mx-auto grid w-full max-w-6xl gap-10 px-4 pb-14 pt-14 sm:px-6 lg:grid-cols-2 lg:items-center lg:px-8 lg:pt-20">
			<div class="relative z-10">
				{title && <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{title}</h2>}
				{subtitle && <p class="mt-3 text-lg font-medium text-white">{subtitle}</p>}
				{text && <p class="mt-3 max-w-xl text-sm leading-7 text-neutral-100">{text}</p>}

				<div class="mt-7 flex flex-wrap gap-4">
					{hasCall && (
						<a
							href={callHref as string}
							class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-3 text-sm font-semibold text-red-500 shadow-sm transition hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-red-500"
						>
							<Icon name="phone" class="h-4 w-4" />
							{callLabel}
						</a>
					)}
					{hasWhatsapp && (
						<a
							href={whatsappHref as string}
							class="inline-flex items-center gap-2 rounded-full border border-white px-5 py-3 text-sm font-semibold text-white transition hover:text-red-500 hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-red-500"
						>
							<Icon name="message" class="h-4 w-4" />
							{whatsappLabel}
						</a>
					)}
				</div>
			</div>

			<div class="relative hidden h-56 lg:block">
				{image ? (
					<img
						src={image.src}
						alt={image.alt}
						class="pointer-events-none absolute -top-28 right-0 z-20 h-auto w-full max-w-xl object-contain drop-shadow-2xl"
					/>
				) : (
					<div class="pointer-events-none absolute -top-24 right-0 z-20 flex h-72 w-72 items-center justify-center opacity-15">
						<Icon name="car-front" class="h-56 w-56 text-white" strokeWidth={1} />
					</div>
				)}
			</div>
		</div>

		<div class="relative border-t border-white/50">
			<div class="mx-auto flex w-full max-w-6xl flex-col gap-2 px-4 py-6 text-xs text-white sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
				<span>&copy; {year} {siteBrand.name}. All rights reserved.</span>
			</div>
		</div>
	</div>
</footer>
