---
import Icon from './Icon.astro';
import type { SiteIconName } from './Icon.astro';

type PackageCardData = {
	icon?: SiteIconName | null;
	title: string;
	price: string;
	detail?: string | null;
	ctaLabel?: string | null;
	ctaHref?: string | null;
	featured?: boolean;
};

type Props = {
	pkg: PackageCardData;
};

const { pkg } = Astro.props as Props;
const hasCta = Boolean(pkg.ctaLabel && pkg.ctaHref);
---

<article
	class:list={[
		'relative flex h-full flex-col justify-between overflow-hidden rounded-3xl border bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg',
		pkg.featured ? 'border-red-200 shadow-red-100 ring-2 ring-red-500/20' : 'border-slate-200',
	]}
>
	{pkg.featured && <span class="absolute inset-x-0 top-0 h-1.5 bg-linear-to-r from-red-200 to-red-200" />}

	{pkg.featured && (
		<span class="absolute top-5 right-5 rounded-full bg-red-600 px-3 py-1 text-[11px] font-semibold tracking-[0.2em] text-white uppercase shadow-sm">
			Most Popular
		</span>
	)}

	<div>
		<div
			class:list={[
				'inline-flex h-12 w-12 items-center justify-center rounded-2xl',
				pkg.featured ? 'bg-red-600 text-white' : 'bg-red-50 text-red-600',
			]}
		>
			<Icon name={pkg.icon ?? 'badge-check'} class="h-6 w-6" />
		</div>

		<h3 class="mt-6 text-xl font-semibold text-slate-900">{pkg.title}</h3>
		<p class="mt-3 text-3xl font-bold tracking-tight text-slate-900">{pkg.price}</p>
		{pkg.detail && <p class="mt-3 text-sm leading-6 text-slate-600">{pkg.detail}</p>}
	</div>

	{hasCta && (
		<a
			href={pkg.ctaHref as string}
			class:list={[
				'mt-6 flex items-center justify-center rounded-full border px-5 py-3 text-sm font-semibold transition focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2 focus-visible:outline-none',
				pkg.featured
					? 'border-red-600 bg-red-600 text-white hover:bg-red-700'
					: 'border-slate-300 text-slate-900 hover:border-red-400 hover:text-red-600',
			]}
		>
			{pkg.ctaLabel}
		</a>
	)}
</article>
