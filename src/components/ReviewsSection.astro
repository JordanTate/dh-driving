---
import Carousel from './Carousel.astro';
import { type ReviewItem, siteContact } from '../constants/site';

type Review = {
	name: string;
	text: string;
	image?: {
		src: string;
		alt: string;
	};
};

type Props = {
	eyebrow?: string | null;
	title?: string | null;
	description?: string | null;
	reviews?: Review[] | null;
};

const { eyebrow, title, description, reviews = [] } = Astro.props as Props;

// Fallback avatar text for reviews without a photo
function getInitials(name: string) {
	return name
		.split(/\s+/)
		.slice(0, 2)
		.map((part) => part.charAt(0).toUpperCase())
		.join('');
}
---

{Array.isArray(reviews) && reviews.length > 0 && (
	<section class="bg-white py-16 sm:py-20">
		<div class="mx-auto grid w-full max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:items-start lg:px-8">
			<div class="max-w-xl lg:pt-4">
				{eyebrow && (
					<p class="mb-3 text-xs font-semibold uppercase tracking-[0.35em] text-red-600">
						{eyebrow}
					</p>
				)}
				{title && <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{title}</h2>}
				{description && <p class="mt-4 text-base leading-7 text-slate-600 sm:text-lg">{description}</p>}
				<a
					href={siteContact.phone.href}
					class="mt-6 inline-flex items-center rounded-full border border-red-600 px-5 py-3 text-sm font-semibold text-red-600 transition hover:bg-red-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2"
				>
					Call us today
				</a>
			</div>

			<div class="min-w-0">
				<Carousel ariaLabel={title ? `${title} carousel` : 'Reviews carousel'}>
					{
						reviews.map((review) => (
							<article class="flex w-full h-full shrink-0 snap-start self-start flex-col rounded-3xl border border-slate-200 bg-slate-50 p-6 shadow-sm xl:w-[calc(50%-0.75rem)]">
								<div class="flex items-center gap-3">
									{review.image ? (
										<img
											src={review.image.src}
											alt={review.image.alt}
											class="h-24 w-24 rounded-xl object-cover object-top ring-2 ring-white shadow-sm"
										/>
									) : (
										<div class="flex h-24 w-24 items-center justify-center rounded-full bg-red-100 font-semibold text-red-600">
											{getInitials(review.name)}
										</div>
									)}
									<h3 class="font-semibold text-slate-900">{review.name}</h3>
								</div>
								<div class="mt-4 text-2xl leading-none text-red-500">“</div>
								<p class="mt-2 max-h-42 overflow-y-auto pr-1 text-sm leading-7 text-slate-600 scrollbar-thin [&::-webkit-scrollbar]:w-1.5 [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-thumb]:bg-slate-300 [&::-webkit-scrollbar-track]:bg-transparent">
									{review.text}
								</p>
							</article>
						))
					}
				</Carousel>
			</div>
		</div>
	</section>
)}