---
  import { heroDefaults } from '../constants/site';
import Icon from './Icon.astro';
import type { SiteIconName } from './Icon.astro';

  type HeroImage = {
    src: string;
    alt: string;
  };

  type HeroUsp = {
    title: string;
    text: string;
    icon?: SiteIconName;
  };

  type HeroTagline = {
    lines: string[];
    icon?: SiteIconName;
  };

  type Props = {
    title?: string | null;
    titleAccent?: string | null;
    description?: string | null;
    ctaLabel?: string | null;
    ctaHref?: string | null;
    image?: HeroImage | null;
    usps?: HeroUsp[] | null;
    sticker?: string | null;
    tagline?: HeroTagline | null;
  };

  const props = Astro.props as Props;

  const title = props.title === undefined ? heroDefaults.title : props.title;
  const titleAccent = props.titleAccent === undefined ? heroDefaults.titleAccent : props.titleAccent;
  const description = props.description === undefined ? heroDefaults.description : props.description;
  const ctaLabel = props.ctaLabel === undefined ? heroDefaults.ctaLabel : props.ctaLabel;
  const ctaHref = props.ctaHref === undefined ? heroDefaults.ctaHref : props.ctaHref;
  const image = props.image === undefined ? heroDefaults.image : props.image;
  const usps = props.usps === undefined ? heroDefaults.usps : props.usps;
  const sticker = props.sticker === undefined ? heroDefaults.sticker : props.sticker;
  const stickerWords = sticker ? sticker.split(' ') : [];
  const tagline = props.tagline === undefined ? heroDefaults.tagline : props.tagline;
  const hasTagline = Boolean(tagline?.lines?.length);
  const hasImage = Boolean(image?.src);
  const hasCta = Boolean(ctaLabel && ctaHref);
---

<section class="max-w-6xl mx-auto isolate overflow-hidden bg-white">
  <div class:list={["mx-auto grid min-h-[calc(100dvh-4rem)] w-full items-center gap-10 px-4 py-12 sm:px-6 md:gap-8 md:py-16 lg:px-8", hasImage ? 'lg:grid-cols-[560px_1fr] relative' : 'lg:grid-cols-1']}>
    {hasImage && image && (
      <div class="relative h-56 overflow-hidden rounded-2xl lg:hidden">
        <img
          src={image.src}
          alt={image.alt}
          class="h-full w-full object-cover"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-linear-to-t from-white/80 via-white/20 to-transparent"></div>
        {stickerWords.length > 0 && (
          <div class="absolute top-3 right-3 z-20 flex h-16 w-16 -rotate-12 flex-col items-center justify-center rounded-full border-4 border-white bg-red-600 text-center shadow-lg">
            {stickerWords.map((word) => (
              <span class="text-[7px] leading-tight font-bold tracking-wide text-white uppercase">{word}</span>
            ))}
          </div>
        )}
        {hasTagline && tagline && (
          <div class="absolute right-0 bottom-4 z-20 flex max-w-[70%] items-center gap-2 rounded-l-full bg-white/95 py-2 pr-4 pl-3 shadow-lg">
            <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-red-600 text-white">
              <Icon name={tagline.icon ?? 'key'} class="h-3.5 w-3.5" />
            </span>
            <p class="text-[9px] leading-tight font-bold uppercase text-slate-900">
              {tagline.lines.map((line, i) => (
                <>
                  <span class:list={[i === tagline.lines.length - 1 && 'text-red-600']}>{line}</span>
                  {i < tagline.lines.length - 1 && <br />}
                </>
              ))}
            </p>
          </div>
        )}
      </div>
      )}

    <div class="relative z-10">
      <h1 class="max-w-[14ch] text-4xl font-bold uppercase tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        {title}
        {titleAccent && (
          <>
            <br />
            <span class="text-red-500">{titleAccent}</span>
          </>
        )}
      </h1>
      {description && (
        <p class="mt-5 max-w-xl text-base leading-7 font-semibold text-slate-600 sm:text-lg">
          {description}
        </p>
      )}
      {hasCta && (
        <a
          href={ctaHref as string}
          class="mt-7 inline-flex items-center gap-2 rounded-full bg-red-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-red-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4">
            <path fill="currentColor" d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1C10.85 21 3 13.15 3 3c0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.24.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2Z"></path>
          </svg>
          {ctaLabel}
        </a>
      )}
    </div>

    {hasImage && image && (
      <div class="absolute top-12 bottom-12 right-4 hidden w-[75%] lg:block rounded-2xl overflow-hidden">
        <img
          src={image.src}
          alt={image.alt}
          class="absolute inset-0 h-full w-full rounded-2xl object-cover"
          loading="eager"
        />
        <div class="absolute inset-0 bg-linear-to-r from-white via-transparent via-20% to-transparent"></div>
      </div>
    )}

    {stickerWords.length > 0 && (
      <div class="absolute top-6 right-6 z-20 hidden h-28 w-28 -rotate-12 flex-col items-center justify-center rounded-full border-4 border-white bg-red-600 text-center shadow-lg lg:flex">
        {stickerWords.map((word) => (
          <span class="text-xs leading-tight font-bold tracking-wide text-white uppercase">{word}</span>
        ))}
      </div>
    )}

    {hasTagline && tagline && (
      <div class="absolute right-0 bottom-36 z-20 hidden max-w-xs items-center gap-3 rounded-l-2xl bg-white/95 py-3 pr-6 pl-4 shadow-xl backdrop-blur lg:flex">
        <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-red-600 text-white">
          <Icon name={tagline.icon ?? 'key'} class="h-5 w-5" />
        </span>
        <p class="text-sm leading-tight font-bold uppercase text-slate-900">
          {tagline.lines.map((line, i) => (
            <>
              <span class:list={[i === tagline.lines.length - 1 && 'text-red-600']}>{line}</span>
              {i < tagline.lines.length - 1 && <br />}
            </>
          ))}
        </p>
      </div>
    )}
  </div>

  {Array.isArray(usps) && usps.length > 0 && (
    <div class="relative z-20 mx-auto max-w-6xl px-4 pb-12 sm:px-6 md:pb-16 lg:-mt-20 lg:px-8">
      <ul class="grid divide-y divide-slate-200 border-t border-b border-slate-200 sm:grid-cols-3 sm:divide-x sm:divide-y-0 lg:rounded-2xl lg:border lg:border-slate-100 lg:bg-white lg:px-4 lg:shadow-xl">
        {
          usps.map((usp) => (
            <li class="flex items-start gap-4 py-6 sm:px-6 sm:first:pl-0 sm:last:pr-0 lg:py-8 lg:first:pl-4 lg:last:pr-4">
              <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-red-50 text-red-600">
                <Icon name={usp.icon ?? 'badge-check'} class="h-5 w-5" />
              </span>
              <div>
                <h2 class="font-semibold text-slate-900">{usp.title}</h2>
                <p class="mt-1 text-sm leading-6 text-slate-600">{usp.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  )}
</section>
