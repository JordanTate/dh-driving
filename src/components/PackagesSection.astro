---
import PackageCard from './PackageCard.astro';
import type { SiteIconName } from './Icon.astro';

type PackageCard = {
	icon?: SiteIconName | null;
	title: string;
	price: string;
	detail?: string | null;
	ctaLabel?: string | null;
	ctaHref?: string | null;
	featured?: boolean;
};

type Props = {
	eyebrow?: string | null;
	title?: string | null;
	description?: string | null;
	packages?: PackageCard[] | null;
};

const {
	eyebrow,
	title,
	description,
	packages = [],
} = Astro.props as Props;
---

{Array.isArray(packages) && packages.length > 0 && (
	<section class="relative overflow-hidden bg-slate-50 py-16 sm:py-20">
		<div class="pointer-events-none absolute top-0 right-0 h-80 w-80 -translate-y-1/3 translate-x-1/3 rounded-full bg-red-200/40 blur-3xl" aria-hidden="true"></div>

		<div class="relative mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
			<div class="max-w-2xl">
				{eyebrow && (
					<p class="mb-3 text-xs font-semibold uppercase tracking-[0.35em] text-red-600">
						{eyebrow}
					</p>
				)}
				{title && <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{title}</h2>}
				{description && <p class="mt-4 text-base leading-7 text-slate-600 sm:text-lg">{description}</p>}
			</div>

			<div class="mt-10 hidden gap-6 md:grid md:grid-cols-2 xl:grid-cols-4">
				{packages.map((pkg) => <PackageCard pkg={pkg} />)}
			</div>

			<package-carousel class="mt-10 block md:hidden">
				<ul data-package-track class="-mx-4 flex snap-x snap-mandatory overflow-x-auto scroll-smooth px-4 pt-2 pb-4 scrollbar-none [&::-webkit-scrollbar]:hidden">
					{
						packages.map((pkg, i) => (
							<li data-package-item class:list={['relative w-[82%] shrink-0 snap-center snap-always', i > 0 && '-ml-6', i === 0 ? 'z-10' : 'z-0']}>
								<PackageCard pkg={pkg} />
							</li>
						))
					}
				</ul>
				{packages.length > 1 && (
					<div data-package-dots class="mt-2 flex items-center justify-center gap-2">
						{packages.map((_, i) => (
							<span data-package-dot class:list={['h-1.5 w-1.5 rounded-full transition-colors', i === 0 ? 'bg-red-600' : 'bg-slate-300']} />
						))}
					</div>
				)}
			</package-carousel>
		</div>
	</section>
)}

<script>
	class PackageCarousel extends HTMLElement {
		track: HTMLElement | null = null;
		dots: HTMLElement[] = [];
		items: HTMLElement[] = [];

		connectedCallback() {
			this.track = this.querySelector('[data-package-track]');
			this.dots = Array.from(this.querySelectorAll('[data-package-dot]'));
			this.items = Array.from(this.querySelectorAll('[data-package-item]'));

			if (!this.track) {
				return;
			}

			this.track.addEventListener('scroll', () => this.handleScroll(), { passive: true });
		}

		handleScroll() {
			if (!this.track) {
				return;
			}

			const scrollLeft = this.track.scrollLeft;

			let closest = 0;
			let minDistance = Infinity;
			this.items.forEach((item, i) => {
				const distance = Math.abs(item.offsetLeft - scrollLeft);
				if (distance < minDistance) {
					minDistance = distance;
					closest = i;
				}
			});

			this.updateDots(closest);
			this.updateActiveCard(closest);
		}

		// Keep the centered card above its overlapping neighbours regardless of DOM order.
		updateActiveCard(index: number) {
			this.items.forEach((item, i) => {
				item.classList.toggle('z-10', i === index);
				item.classList.toggle('z-0', i !== index);
			});
		}

		updateDots(index: number) {
			this.dots.forEach((dot, i) => {
				dot.classList.toggle('bg-red-600', i === index);
				dot.classList.toggle('bg-slate-300', i !== index);
			});
		}
	}

	if (!customElements.get('package-carousel')) {
		customElements.define('package-carousel', PackageCarousel);
	}
</script>
