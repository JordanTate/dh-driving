---
import Icon from './Icon.astro';
import type { SiteIconName } from './Icon.astro';

type UspItem = {
	text: string;
	icon?: SiteIconName | null;
};

type Props = {
	items?: UspItem[] | null;
};

const { items = [] } = Astro.props as Props;
---

{Array.isArray(items) && items.length > 0 && (
	<section class="border-y border-slate-200 bg-white py-6">
		<div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
			<ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
				{
					items.map((item) => (
						<li class="flex items-center gap-2 rounded-xl px-2 py-2 text-sm text-slate-700">
							<span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-red-50 text-red-600">
								<Icon name={item.icon ?? 'badge-check'} class="h-4 w-4" />
							</span>
							<span class="font-medium leading-6">{item.text}</span>
						</li>
					))
				}
			</ul>
		</div>
	</section>
)}